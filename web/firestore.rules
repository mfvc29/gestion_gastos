rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de seguridad para la colección de usuarios
    match /users/{userId}/{document=**} {
      // Solo el usuario autenticado (cuyo UID coincida con userId) puede leer o escribir sus propios datos
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
